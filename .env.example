# VAULT environment variables template
# Copy to .env.local and fill in your values

# Database
DATABASE_URL=postgresql://...

# Public site URL (no trailing slash) — used in order emails for “Activate account” links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Supabase Storage (optional — used for other integrations if needed)
NEXT_PUBLIC_SUPABASE_URL=https://...supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare R2 (image storage — product, hero, lookbook)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket-name
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Optional: Order emails
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@yourdomain.com

# Rate limiting (Upstash Redis) — enables production-grade rate limiting
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Internal audit ingestion (middleware → DB). Generate a long random string; never expose to the client.
INTERNAL_AUDIT_SECRET=

# Analytics (PostHog) — privacy-respecting event tracking
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
