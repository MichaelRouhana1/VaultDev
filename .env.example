# VAULT environment variables template
# Copy to .env.local and fill in your values

# Database
DATABASE_URL=postgresql://...

# Public site URL (no trailing slash) — used in order emails for “Activate account” links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
# Keep auth on your app (custom appearance applies here). Without these, Clerk may send users to *.accounts.dev.
# Sign-in/up pages live under `/{locale}/sign-in` (see app/[locale]/sign-in). Point these at the URLs you use after next-intl (often `/en/sign-in`) and match the Clerk Dashboard application paths.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/sign-up
# Avoid deprecated Clerk env vars (console warnings): do not set NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL /
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL — use Dashboard paths and/or signInFallbackRedirectUrl on ClerkProvider (see app/layout.tsx).

# Supabase Storage (optional — used for other integrations if needed)
# Hostname is also used for CSP + next/image (see lib/constants/security-hosts.ts)
NEXT_PUBLIC_SUPABASE_URL=https://...supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare R2 (image storage — product, hero, lookbook)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket-name
# Public R2 URL — CSP img-src + next/image allowlist (hostname parsed from this URL)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Optional: Order emails
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@yourdomain.com

# Rate limiting (Upstash Redis) — enables production-grade rate limiting
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Optional: lock the entire deployment behind HTTP Basic Auth (e.g. secret client preview on Vercel).
# When true, every matched route (pages, API, /_next static chunks) requires Authorization: Basic …
# except POST /api/internal/security-audit with a valid x-mosaik-internal-secret (server/middleware ingest).
# REQUIRE_SITE_PASSWORD=true
# SITE_AUTH_USER=
# SITE_AUTH_PASSWORD=

# Internal API secret — middleware and server code send it as header `x-mosaik-internal-secret` to POST /api/internal/security-audit.
# Generate a long random string; never expose to the client.
INTERNAL_API_SECRET=
# Optional legacy name: used only if INTERNAL_API_SECRET is unset (same value as above during migration).
# INTERNAL_AUDIT_SECRET=
